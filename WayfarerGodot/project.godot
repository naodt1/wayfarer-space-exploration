; Wayfarer — Godot 4 port of the native macOS game (../WayfarerMac).

config_version=5

[application]

config/name="Wayfarer"
config/description="A quiet solar system, generated as you fly. Land anywhere."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/vsync/vsync_mode=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
